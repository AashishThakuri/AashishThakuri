biform 1

identity {
  name: "Aashish Thakuri"
  place: "Kathmandu, Nepal"
  role: "full-stack developer and systems experimenter"
  thesis: "I build the mechanism, then make it visible."
  statement: "My work moves between product engineering, applied AI, computer vision, data, and interactive software. The common thread is simple: the system should be inspectable, useful, and alive in the hands of the person using it."
  artifact: "One physical file. Two valid readings. GitHub sees the surface as an image; an archive reader opens the source, compiler, assets, and proof inside the same bytes."
  github: "https://github.com/AashishThakuri"
}

